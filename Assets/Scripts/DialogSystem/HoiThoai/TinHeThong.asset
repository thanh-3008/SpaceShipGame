  m_Script: {fileID: 11500000, guid: a870c553808a7a345ad99b7b8f95d653, type: 3}
  m_Name: TinHeThong
  m_EditorClassIdentifier: Assembly-CSharp::Conversation
  lines:
  - speaker: {fileID: 11400000, guid: 0db9dfdc7b897134daf41055a1bf16ba, type: 2}
    text: "Ng\u01B0\u01A1i \u0111\u1ECBnh tin m\u1ED9t K\u1EBB D\u1ED1i Tr\xE1 sao?"
  - speaker: {fileID: 11400000, guid: 5b11d4b5f18805c47be91dd3d980b033, type: 2}
    text: "Ta l\xE0 k\u1EBB d\u1ED1i tr\xE1? Ch\xEDnh h\u1EAFn l\xE0 k\u1EBB \u0111\xE3
      giam c\u1EA7m ng\u01B0\u01A1i trong V\xF2ng L\u1EB7p n\xE0y! H\xE3y tin ta.
      Ta s\u1EBD cho ng\u01B0\u01A1i 't\u1EF1 do' th\u1EF1c s\u1EF1. Ch\u1EC9 c\u1EA7n...
      ti\xEAu di\u1EC7t Metatron. "
  - speaker: {fileID: 11400000, guid: 5b11d4b5f18805c47be91dd3d980b033, type: 2}
    text: "H\u1EAFn l\xE0 'B\u1EE9c T\u01B0\u1EDDng L\u1EEDa' cu\u1ED1i c\xF9ng.
      Ph\xE1 h\u1EE7y h\u1EAFn, v\xE0 L\xF5i n\xE0y l\xE0 c\u1EE7a ch\xFAng ta! C\xF2n
      Azure, ta s\u1EBD k\xECm ch\xE2n h\u1EAFn!"
  - speaker: {fileID: 11400000, guid: 0db9dfdc7b897134daf41055a1bf16ba, type: 2}
    text: "T\xEAn ngu ng\u1ED1c n\xE0y......."
  choices: []
