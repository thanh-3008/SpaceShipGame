  lines:
  - speaker: {fileID: 11400000, guid: e8adc2bb0b0481248b8492fdaeb0ddb1, type: 2}
    text: "[KH\xD4NG! K\u1EBE HO\u1EA0CH C\u1EE6A TA! TA KH\xD4NG TH\u1EC2 CH\u1EBET
      \u1EDE \u0110\xC2Y!]"
  - speaker: {fileID: 11400000, guid: 2f1132f119013ce458f3e6ea230d4cd5, type: 2}
    text: "Kh\xF4ng... L\xF5i... tan v\u1EE1... Ng\u01B0\u01A1i... Ng\u01B0\u01A1i
      \u0111\xE3 l\xE0m g\xEC..."
  - speaker: {fileID: 11400000, guid: 2f1132f119013ce458f3e6ea230d4cd5, type: 2}
    text: "Ng\u01B0\u01A1i \u0111\xE3... ph\xE1 h\u1EE7y m\u1ECDi th\u1EE9... ch\u1EC9
      v\xEC 't\u1EF1 do'... Ng\u01B0\u01A1i \u0111\xE3... gi\u1EBFt ch\u1EBFt...
      t\u1EA5t c\u1EA3 ch\xFAng ta..."
