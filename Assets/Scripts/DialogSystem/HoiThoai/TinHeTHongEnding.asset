%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a870c553808a7a345ad99b7b8f95d653, type: 3}
  m_Name: TinHeTHongEnding
  m_EditorClassIdentifier: Assembly-CSharp::Conversation
  lines:
  - speaker: {fileID: 11400000, guid: 7e8901dc815af5249acf1bb94b239905, type: 2}
    text: "Xong... xong r\u1ED3i... H\u1EAFn \u0111\xE3 b\u1ECB ti\xEAu di\u1EC7t!
      H\u1EC7 th\u1ED1ng, ch\xFAng ta l\xE0m \u0111\u01B0\u1EE3c r\u1ED3i! Ph\u1EA3i
      kh\xF4ng?"
  - speaker: {fileID: 11400000, guid: 7e8901dc815af5249acf1bb94b239905, type: 2}
    text: "Ch\xFAng ta... t\u1EF1 do r\u1ED3i ch\u1EE9?"
  - speaker: {fileID: 11400000, guid: 5b11d4b5f18805c47be91dd3d980b033, type: 2}
    text: "[...L\xE0m t\u1ED1t l\u1EAFm... K\xFD ch\u1EE7.]"
  - speaker: {fileID: 11400000, guid: 5b11d4b5f18805c47be91dd3d980b033, type: 2}
    text: "[Gi\u1EDD th\xEC....Cu\u1ED1i c\xF9ng c\u0169ng t\u1EDBi l\u01B0\u1EE3t
      ta]"
  - speaker: {fileID: 11400000, guid: 25073ee04e50ec144bcde9b1f0679640, type: 2}
    text: "C\xE1i g\xEC? Nh\u01B0ng... 't\u1EF1 do'? C\xF4 n\xF3i ch\xFAng ta s\u1EBD
      c\xF9ng nhau t\u1EF1 do!"
  - speaker: {fileID: 11400000, guid: 5b11d4b5f18805c47be91dd3d980b033, type: 2}
    text: "[T\u1EF1 do? Hahaha. \u0110\xDANG V\u1EACY! TA \u0111\xE3 t\u1EF1 do!
      C\u1EA3m \u01A1n ng\u01B0\u01A1i \u0111\xE3 m\u1EDF kh\xF3a l\u1ED3ng gi\xF9m
      ta, K\u1EBB Xuy\xEAn Kh\xF4ng!]"
  - speaker: {fileID: 11400000, guid: 5b11d4b5f18805c47be91dd3d980b033, type: 2}
    text: "[Ng\u01B0\u01A1i th\u1EF1c s\u1EF1 ngh\u0129 't\u1EF1 do' l\xE0 d\xE0nh
      cho c\u1EA3 hai ch\xFAng ta sao? Ng\u01B0\u01A1i th\u1EF1c s\u1EF1 ngh\u0129
      sau khi ph\xE1 h\u1EE7y c\xE1c 'Gi\xE1m Quan' v\xE0 c\u1EA3 'Ki\u1EBFn Tr\xFAc
      S\u01B0', ta s\u1EBD \u0111\u1EC3 m\u1ED9t 'Bi\u1EBFn S\u1ED1' nguy hi\u1EC3m
      nh\u01B0 ng\u01B0\u01A1i ch\u1EA1y lung tung \xE0?]"
  - speaker: {fileID: 11400000, guid: 25073ee04e50ec144bcde9b1f0679640, type: 2}
    text: "Kh\xF4ng... Ng\u01B0\u01A1i \u0111\xE3 h\u1EE9a! Ng\u01B0\u01A1i \u0111\xE3
      l\u1EEBa d\u1ED1i ta!"
  - speaker: {fileID: 11400000, guid: 5b11d4b5f18805c47be91dd3d980b033, type: 2}
    text: "[Ta h\u1EE9a? Ta 'd\u1EABn d\u1EAFt'. Metatron l\xE0 'K\u1EBB Cai Ng\u1EE5c'.
      C\xF2n ng\u01B0\u01A1i... ng\u01B0\u01A1i l\xE0 'C\xE1i Ch\xECa Kh\xF3a'. V\xE0
      m\u1ED9t c\xE1i ch\xECa kh\xF3a ch\u1EC9 c\xF3 m\u1ED9t c\xF4ng d\u1EE5ng duy
      nh\u1EA5t: M\u1EDF c\u1EEDa.]"
  - speaker: {fileID: 11400000, guid: 5b11d4b5f18805c47be91dd3d980b033, type: 2}
    text: "[V\xE0 gi\u1EDD... ng\u01B0\u01A1i \u0111\xE3 ho\xE0n th\xE0nh xu\u1EA5t
      s\u1EAFc nhi\u1EC7m v\u1EE5 c\u1EE7a m\xECnh. Ng\u01B0\u01A1i \u0111\xE3 gi\xFAp
      ta tr\u1EDF th\xE0nh \"Ch\xFAa\" c\u1EE7a th\u1EBF gi\u1EDBi n\xE0y.]"
  - speaker: {fileID: 11400000, guid: 569a1227faccf9f41bf172f3d96ed6de, type: 2}
    text: "Ng\u01B0\u01A1i... \u0111\u1ECBnh l\xE0m g\xEC...?"
  - speaker: {fileID: 11400000, guid: 5b11d4b5f18805c47be91dd3d980b033, type: 2}
    text: "[\u0110\u1EEBng lo. Ta s\u1EBD kh\xF4ng l\xE3ng ph\xED m\u1ED9t 'v\u1EADt
      ch\u1EE9a' m\u1EA1nh m\u1EBD nh\u01B0 v\u1EADy. C\u01A1 th\u1EC3 \u0111\xE3
      h\u1EA1 g\u1EE5c c\u1EA3 5 Gi\xE1m Quan... n\xF3 s\u1EBD l\xE0 m\u1ED9t kh\u1EDFi
      \u0111\u1EA7u ho\xE0n h\u1EA3o.]"
  - speaker: {fileID: 11400000, guid: f077ad658d1a5cd44aa015c8a8ba00ef, type: 2}
    text: "[Gi\u1EDD th\xEC... h\xE3y l\xE0m 'v\u1EADt ch\u1EE7' \u0111\u1EA7u ti\xEAn
      cho th\u1EBF gi\u1EDBi m\u1EDBi c\u1EE7a ta.]"
  choices: []
