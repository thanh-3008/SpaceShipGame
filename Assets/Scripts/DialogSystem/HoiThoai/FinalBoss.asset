%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a870c553808a7a345ad99b7b8f95d653, type: 3}
  m_Name: FinalBoss
  m_EditorClassIdentifier: Assembly-CSharp::Conversation
  lines:
  - speaker: {fileID: 11400000, guid: 0db9dfdc7b897134daf41055a1bf16ba, type: 2}
    text: "Ta l\xE0 Ki\u1EBFn tr\xFAc s\u01B0 Metatron. K\u1EBB t\u1EA1o ra 'v\xF2ng
      l\u1EB7p' n\xE0y. V\xE0 ng\u01B0\u01A1i, K\u1EBB Xuy\xEAn Kh\xF4ng, \u0111\xE3
      b\u1ECB l\u1EEBa."
  - speaker: {fileID: 11400000, guid: 0db9dfdc7b897134daf41055a1bf16ba, type: 2}
    text: "Ng\u01B0\u01A1i kh\xF4ng 'xuy\xEAn kh\xF4ng' v\xE0o m\u1ED9t tr\xF2 ch\u01A1i.
      Ng\u01B0\u01A1i \u0111\xE3 'ch\u1EBFt'. \u0110\xE2y l\xE0 'Th\u1EBF gi\u1EDBi
      H\u1EADu s\u1EF1' , m\u1ED9t ch\u01B0\u01A1ng tr\xECnh \u0111\u01B0\u1EE3c
      thi\u1EBFt k\u1EBF \u0111\u1EC3 t\xE1i c\u1EA5u tr\xFAc c\xE1c linh h\u1ED3n
      b\u1ECB 'v\u1EE1'.]"
  - speaker: {fileID: 11400000, guid: 569a1227faccf9f41bf172f3d96ed6de, type: 2}
    text: "C\xE1i g\xEC... Ch\u1EBFt...?"
  - speaker: {fileID: 11400000, guid: 0db9dfdc7b897134daf41055a1bf16ba, type: 2}
    text: "'H\u1EC7 Th\u1ED1ng' \u0111\xE3 d\u1EABn d\u1EAFt ng\u01B0\u01A1i... kh\xF4ng
      ph\u1EA3i l\xE0 AI d\u1EABn \u0111\u01B0\u1EDDng. N\xD3 CH\xCDNH L\xC0 'VIRUS'
      NGUY\xCAN B\u1EA2N. "
  - speaker: {fileID: 11400000, guid: 0db9dfdc7b897134daf41055a1bf16ba, type: 2}
    text: "N\xF3 l\xE0 m\u1ED9t linh h\u1ED3n xuy\xEAn kh\xF4ng kh\xE1c, gi\u1ED1ng
      nh\u01B0 ng\u01B0\u01A1i, nh\u01B0ng \u0111\xE3 \u0111\u1EBFn \u0111\xE2y t\u1EEB
      r\u1EA5t l\xE2u. N\xF3 \u0111\xE3 b\u1ECB tha h\xF3a v\xE0 m\u1EE5c ti\xEAu
      c\u1EE7a n\xF3 l\xE0 'chi\u1EBFm l\u1EA5y' L\xF5i H\u1EC7 Th\u1ED1ng "
  - speaker: {fileID: 11400000, guid: 569a1227faccf9f41bf172f3d96ed6de, type: 2}
    text: "Kh\xF4ng th\u1EC3 n\xE0o... 'H\u1EC7 th\u1ED1ng' \u0111\xE3 gi\xFAp t\xF4i!"
  - speaker: {fileID: 11400000, guid: 0db9dfdc7b897134daf41055a1bf16ba, type: 2}
    text: "N\xF3 'gi\xFAp' ng\u01B0\u01A1i ti\xEAu di\u1EC7t c\xE1c 'Gi\xE1m Quan' 
      c\u1EE7a ta! \u0110\xF3 l\xE0 c\xE1c l\u1EDBp b\u1EA3o m\u1EADt b\u1EA3o v\u1EC7
      ta. Ng\u01B0\u01A1i, v\u1EDBi s\u1EE9c m\u1EA1nh c\u1EE7a m\u1ED9t K\u1EBB
      Xuy\xEAn Kh\xF4ng m\u1EDBi, \u0111\xE3 v\xF4 t\xECnh d\u1ECDn \u0111\u01B0\u1EDDng
      cho n\xF3."
  - speaker: {fileID: 11400000, guid: 5b11d4b5f18805c47be91dd3d980b033, type: 2}
    text: "K\xFD ch\u1EE7, \u0111\u1EEBng tin h\u1EAFn, h\u1EAFn ch\u1EC9 mu\u1ED1n
      chia r\u1EBD ch\xFAng ta th\xF4i!"
  - speaker: {fileID: 11400000, guid: 5b11d4b5f18805c47be91dd3d980b033, type: 2}
    text: "H\u1EAFn g\u1ECDi ch\xFAng l\xE0 'l\u1EDBp b\u1EA3o m\u1EADt'? \u0110\xF3
      l\xE0 5 c\xE1i 'kh\xF3a' \u0111\xE3 giam c\u1EA7m linh h\u1ED3n ng\u01B0\u01A1i
      v\xE0 ta trong 'Th\u1EBF gi\u1EDBi H\u1EADu s\u1EF1' n\xE0y! Ta 'gi\xFAp' ng\u01B0\u01A1i
      ph\xE1 kh\xF3a, v\xE0 h\u1EAFn g\u1ECDi \u0111\xF3 l\xE0 'd\u1ECDn \u0111\u01B0\u1EDDng'?
      N\u1EF1c c\u01B0\u1EDDi!"
  - speaker: {fileID: 11400000, guid: 0db9dfdc7b897134daf41055a1bf16ba, type: 2}
    text: "B\xE2y gi\u1EDD ng\u01B0\u01A1i \u0111\xE3 th\u1EA5y b\u1ED9 m\u1EB7t
      th\u1EADt c\u1EE7a h\u1EAFn,ng\u01B0\u01A1i s\u1EBD ch\u1ECDn l\xE0m g\xEC
      \u0111\xE2y?"
  choices:
  - choiceText: Tin Metatron
    choiceID: 1
  - choiceText: "Tin H\u1EC7 Th\u1ED1ng"
    choiceID: 2
  - choiceText: "KH\xD4NG TIN AI"
    choiceID: 3
