  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a870c553808a7a345ad99b7b8f95d653, type: 3}
  m_Name: TinMetatronEnding
  m_EditorClassIdentifier: Assembly-CSharp::Conversation
  lines:
  - speaker: {fileID: 11400000, guid: 331a6e5691142814bbd2adfd5dbe41b2, type: 2}
    text: "[KH\xD4NG... KH\xD4NG! T\xCAN NGU NG\u1ED0C! NG\u01AF\u01A0I... NG\u01AF\u01A0I
      \u0110\xC3 CH\u1ECCN... PHE C\u1EE6A K\u1EBA CAI NG\u1EE4C...!]"
  - speaker: {fileID: 11400000, guid: 331a6e5691142814bbd2adfd5dbe41b2, type: 2}
    text: "[NG\u01AF\u01A0I S\u1EBC H\u1ED0I H\u1EACN V\xCC \u0110I\u1EC0U N\xC0Y!
      H\u1EAEN S\u1EBC KH\xD4NG BAO GI\u1EDC... TH\u1EA2 NG\u01AF\u01A0I \u0110\xC2U...!]"
  - speaker: {fileID: 11400000, guid: 7e8901dc815af5249acf1bb94b239905, type: 2}
    text: "H\u1EBFt... h\u1EBFt r\u1ED3i. H\u1EAFn \u0111\xE3 bi\u1EBFn m\u1EA5t.
      Metatron! Ta \u0111\xE3 l\xE0m \u0111i\u1EC1u ng\u01B0\u01A1i mu\u1ED1n! Virus
      \u0111\xE3 b\u1ECB tr\u1EE5c xu\u1EA5t!"
  - speaker: {fileID: 11400000, guid: 0db9dfdc7b897134daf41055a1bf16ba, type: 2}
    text: "\u0110\xFAng v\u1EADy. Ng\u01B0\u01A1i \u0111\xE3 ho\xE0n th\xE0nh vai
      tr\xF2 c\u1EE7a m\xECnh. Ng\u01B0\u01A1i \u0111\xE3 ch\u1EE9ng minh... ng\u01B0\u01A1i
      c\u1EF1c k\u1EF3 nguy hi\u1EC3m."
  - speaker: {fileID: 11400000, guid: 25073ee04e50ec144bcde9b1f0679640, type: 2}
    text: "Nguy hi\u1EC3m? Ta \u0111\xE3 gi\xFAp ng\u01B0\u01A1i! Ta \u0111\xE3 ch\u1ECDn
      Tr\u1EADt T\u1EF1! Ta mu\u1ED1n v\u1EC1 nh\xE0!"
  - speaker: {fileID: 11400000, guid: 0db9dfdc7b897134daf41055a1bf16ba, type: 2}
    text: "Ng\u01B0\u01A1i \u0111\xE3 ch\u1ECDn Tr\u1EADt T\u1EF1. Nh\u01B0ng b\u1EA3n
      ch\u1EA5t c\u1EE7a ng\u01B0\u01A1i l\xE0 'H\u1ED7n Lo\u1EA1n'. M\u1ED9t 'K\u1EBB
      Xuy\xEAn Kh\xF4ng' m\u1EA1nh m\u1EBD \u0111\u1EBFn m\u1EE9c c\xF3 th\u1EC3
      ti\xEAu di\u1EC7t t\u1EA5t c\u1EA3 Gi\xE1m Quan c\u1EE7a ta V\xC0 \u0111\xE1nh
      b\u1EA1i Virus... Ng\u01B0\u01A1i ngh\u0129 ta c\xF3 th\u1EC3 \u0111\u1EC3
      m\u1ED9t th\u1EF1c th\u1EC3 nh\u01B0 v\u1EADy 't\u1EF1 do' sao?"
  - speaker: {fileID: 11400000, guid: 25073ee04e50ec144bcde9b1f0679640, type: 2}
    text: "Ng\u01B0\u01A1i... Ng\u01B0\u01A1i \u0111\xE3 h\u1EE9a! Ng\u01B0\u01A1i
      \u0111\xE3 l\u1EEBa ta!"
  - speaker: {fileID: 11400000, guid: 0db9dfdc7b897134daf41055a1bf16ba, type: 2}
    text: "Ta l\xE0 Tr\u1EADt T\u1EF1. Ta kh\xF4ng l\u1EEBa d\u1ED1i. Ta 't\xE1i
      s\u1EED d\u1EE5ng'. Ng\u01B0\u01A1i qu\xE1 m\u1EA1nh \u0111\u1EC3 b\u1ECB 't\xE1i
      c\u1EA5u tr\xFAc' nh\u01B0 nh\u1EEFng linh h\u1ED3n v\u1EE1 kh\xE1c, nh\u01B0ng
      c\u0169ng qu\xE1 nguy hi\u1EC3m \u0111\u1EC3 t\u1ED3n t\u1EA1i t\u1EF1 do.
      Ng\u01B0\u01A1i \u0111\xE3 ph\xE1 h\u1EE7y c\xE1c Gi\xE1m Quan c\u1EE7a ta...
      t\u1EA1o ra m\u1ED9t l\u1ED7 h\u1ED5ng nghi\xEAm tr\u1ECDng trong h\u1EC7 th\u1ED1ng
      ph\xF2ng th\u1EE7 c\u1EE7a L\xF5i."
  - speaker: {fileID: 11400000, guid: 0db9dfdc7b897134daf41055a1bf16ba, type: 2}
    text: "Nh\u01B0ng \u0111\u1EEBng lo. Ta s\u1EBD cho ng\u01B0\u01A1i m\u1ED9t
      'm\u1EE5c \u0111\xEDch' m\u1EDBi. M\u1ED9t vinh d\u1EF1."
  - speaker: {fileID: 11400000, guid: 25073ee04e50ec144bcde9b1f0679640, type: 2}
    text: "M\u1EE5c \u0111\xEDch g\xEC? Ng\u01B0\u01A1i... ng\u01B0\u01A1i \u0111\u1ECBnh
      l\xE0m g\xEC...?"
  - speaker: {fileID: 11400000, guid: 0db9dfdc7b897134daf41055a1bf16ba, type: 2}
    text: "H\u1EC7 th\u1ED1ng c\u1EA7n nh\u1EEFng 'Gi\xE1m Quan' m\u1EDBi. V\xE0
      ng\u01B0\u01A1i, v\u1EDBi s\u1EE9c m\u1EA1nh \u0111\xE3 \u0111\u01B0\u1EE3c
      ch\u1EE9ng minh, s\u1EBD l\xE0 s\u1EF1 thay th\u1EBF ho\xE0n h\u1EA3o."
  - speaker: {fileID: 11400000, guid: 0db9dfdc7b897134daf41055a1bf16ba, type: 2}
    text: "H\xE3y tr\u1EDF th\xE0nh 'Gi\xE1m Quan Th\u1EE9 S\xE1u' (The Sixth Warden).
      H\xE3y tr\u1EDF th\xE0nh 'L\xE1 Ch\u1EAFn c\u1EE7a L\xF5i'. \u0110\xE2y l\xE0
      'Tr\u1EADt T\u1EF1' m\u1EDBi c\u1EE7a ng\u01B0\u01A1i. \u0110\xE2y l\xE0 s\u1EF1
      t\u1ED3n t\u1EA1i v\u0129nh c\u1EEDu c\u1EE7a ng\u01B0\u01A1i."
  - speaker: {fileID: 11400000, guid: f88bd3cacbc707f41b624bbab0f2767c, type: 2}
    text: "KH\xD4NG! TA KH\xD4NG PH\u1EA2I L\xC0 C\xD4NG C\u1EE4 C\u1EE6A NG\u01AF\u01A0I!
      TA KH\xD4NG MU\u1ED0N! D\u1EEANG L\u1EA0I... AAAAA...!"
  - speaker: {fileID: 11400000, guid: 675bc626c3b646b439b984e49c73db7a, type: 2}
    text: .........
  - speaker: {fileID: 11400000, guid: 0db9dfdc7b897134daf41055a1bf16ba, type: 2}
    text: "T\u1EEB gi\u1EDD ta giao nhi\u1EC7m v\u1EE5 cho ng\u01B0\u01A1i,ti\xEAu
      di\u1EC7t b\u1EA5t c\u1EE9 k\u1EBB n\xE0o ti\u1EBFp c\u1EADn l\xF5i,\"Gi\xE1o
      Quan Th\u1EE9 S\xE1u c\u1EE7a ta\""
  - speaker: {fileID: 11400000, guid: 0affa1149dd47ed47abc986e886da1a5, type: 2}
    text: "......V\xE2ng....Th\u01B0a....Ng\xE0i......"
  choices: []
