  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\U0001F3AE H\u01AF\u1EDANG D\u1EAAN THAO T\xC1C\n1. Thao T\xE1c C\u01A1
    B\u1EA3n (Di chuy\u1EC3n & T\u1EA5n c\xF4ng)\nDi chuy\u1EC3n: S\u1EED d\u1EE5ng
    W, A, S, D \u0111\u1EC3 \u0111i\u1EC1u khi\u1EC3n t\xE0u bay l\xEAn, tr\xE1i,
    xu\u1ED1ng, v\xE0 ph\u1EA3i.\nB\u1EAFn C\u01A1 B\u1EA3n: S\u1EED d\u1EE5ng [Chu\u1ED9t
    Tr\xE1i] \u0111\u1EC3 b\u1EAFn \u0111\u1EA1n. (B\u1EA1n c\xF3 th\u1EC3 thay \u0111\u1ED5i
    n\u1EBFu n\xFAt b\u1EAFn c\u1EE7a b\u1EA1n l\xE0 n\xFAt kh\xE1c).\nPh\xF3ng T\xEAn
    L\u1EEDa: Nh\u1EA5n ph\xEDm E \u0111\u1EC3 ph\xF3ng m\u1ED9t qu\u1EA3 t\xEAn
    l\u1EEDa (C\u1EA7n thu th\u1EADp Sao \u0110\u1ECF).\n2. Thao T\xE1c K\u1EF9 N\u0103ng
    (S\u1EED d\u1EE5ng Thanh N\u1ED9)\nPh\xE1 h\u1EE7y Thi\xEAn Th\u1EA1ch s\u1EBD
    gi\xFAp b\u1EA1n t\xEDch l\u0169y N\u1ED9. B\u1EA1n c\xF3 th\u1EC3 t\xEDch tr\u1EEF
    t\u1ED1i \u0111a 3 v\u1EA1ch N\u1ED9.\nK\u1EF9 N\u0103ng Th\u01B0\u1EDDng (Chi\u1EBFn
    Thu\u1EADt)\nPh\xEDm: Nh\u1EA5n F\nTi\xEAu hao: 1 v\u1EA1ch N\u1ED9\nC\xF4ng
    d\u1EE5ng: (M\xF4 t\u1EA3 k\u1EF9 n\u0103ng F c\u1EE7a b\u1EA1n \u1EDF \u0111\xE2y,
    v\xED d\u1EE5: \"B\u1EAFn m\u1ED9t ph\xE1t ph\xE1o n\u0103ng l\u01B0\u1EE3ng\",
    \"L\u01B0\u1EDBt nhanh m\u1ED9t \u0111o\u1EA1n\" ho\u1EB7c \"T\u1EA1o khi\xEAn
    ch\u1EAFn \u0111\u1EA1n\")\nK\u1EF9 N\u0103ng \u0110\u1EB7c Bi\u1EC7t (T\u1ED1i
    Th\u01B0\u1EE3ng)\nPh\xEDm: Nh\u1EA5n Space (Ph\xEDm c\xE1ch)\nTi\xEAu hao: TO\xC0N
    B\u1ED8 (3 v\u1EA1ch) N\u1ED9\nC\xF4ng d\u1EE5ng: Gi\u1EA3i ph\xF3ng m\u1ED9t
    s\u1EE9c m\u1EA1nh h\u1EE7y di\u1EC7t, d\u1ECDn d\u1EB9p to\xE0n b\u1ED9 k\u1EBB
    th\xF9 tr\xEAn m\xE0n h\xECnh v\xE0 gi\xFAp b\u1EA1n tho\xE1t kh\u1ECFi t\xECnh
    hu\u1ED1ng nguy hi\u1EC3m.\n3. Thao T\xE1c N\xE2ng C\u1EA5p (Thu th\u1EADp)\nBay
    t\xE0u c\u1EE7a b\u1EA1n (d\xF9ng WASD) v\xE0o c\xE1c v\u1EADt ph\u1EA9m \u0111\u1EC3
    nh\u1EB7t ch\xFAng:\nSao V\xE0ng: T\u0103ng S\xE1t th\u01B0\u01A1ng \u0111\u1EA1n
    v\xE0 t\u0103ng \u0111i\u1EC3m.\nSao \u0110\u1ECF: Th\xEAm 1 T\xEAn L\u1EEDa
    (cho ph\xEDm E).\n\U0001F3C6 M\u1EE5c Ti\xEAu C\u1EE7a B\u1EA1n\nD\xF9ng WASD
    \u0111\u1EC3 n\xE9 \u0111\u1EA1n.\nD\xF9ng [Chu\u1ED9t Tr\xE1i] v\xE0 E \u0111\u1EC3
    t\u1EA5n c\xF4ng.\nS\u1EED d\u1EE5ng F (1 N\u1ED9) m\u1ED9t c\xE1ch h\u1EE3p
    l\xFD \u0111\u1EC3 x\u1EED l\xFD t\xECnh hu\u1ED1ng kh\xF3.\nS\u1EED d\u1EE5ng
    Space (3 N\u1ED9) khi b\u1ECB bao v\xE2y ho\u1EB7c c\u1EA7n d\u1ECDn d\u1EB9p
    m\xE0n h\xECnh.\nS\u1ED1ng s\xF3t v\xE0 \u0111\u1EA1t \u0111i\u1EC3m s\u1ED1
    cao nh\u1EA5t!"
