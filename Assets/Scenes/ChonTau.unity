  m_Script: {fileID: 11500000, guid: 88bee1a24f5a5c643ad19ed803dadc66, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ChonTau
  ThongTinTau:
  - Tau: {fileID: 701914074940076248, guid: bde1f22cbfcaf6142a4f93e96125ea86, type: 3}
    Sprite: {fileID: 21300000, guid: c4f8a01fad80ab74f8e250b688d74a55, type: 3}
    Name: "V\u1EC7 Binh Aegis"
    Description: "L\xE0 Ch\u1EC9 huy Eva Rostova, ni\u1EC1m t\u1EF1 h\xE0o c\u1EE7a
      h\u1EA1m \u0111\u1ED9i Li\xEAn Minh Titan, b\u1EA1n l\xE0 hi\u1EC7n th\xE2n
      cho k\u1EF7 lu\u1EADt v\xE0 tr\u1EADt t\u1EF1 trong m\u1ED9t v\u0169 tr\u1EE5
      h\u1ED7n lo\u1EA1n. Chi\u1EBFn h\u1EA1m V\u1EC7 Binh Aegis d\u01B0\u1EDBi quy\u1EC1n
      c\u1EE7a b\u1EA1n l\xE0 m\u1ED9t ph\xE1o \u0111\xE0i bay, \u0111\u01B0\u1EE3c
      thi\u1EBFt k\u1EBF kh\xF4ng ch\u1EC9 \u0111\u1EC3 chi\u1EBFn \u0111\u1EA5u,
      m\xE0 c\xF2n \u0111\u1EC3 \xE1p \u0111\u1EB7t \xFD ch\xED c\u1EE7a Li\xEAn
      Minh.  H\u1ED9i \u0110\u1ED3ng T\u1ED1i Cao \u0111\xE3 nh\u1EADn \u0111\u1ECBnh
      L\xF5i Genesis l\xE0 m\u1ED9t c\xF4ng ngh\u1EC7 qu\xE1 nguy hi\u1EC3m \u0111\u1EC3
      t\u1ED3n t\u1EA1i ngo\xE0i t\u1EA7m ki\u1EC3m so\xE1t. Nhi\u1EC7m v\u1EE5 ban
      \u0111\u1EA7u c\u1EE7a b\u1EA1n l\xE0 t\u1ECBch thu n\xF3 m\u1ED9t c\xE1ch
      h\xF2a b\xECnh, nh\u01B0ng cu\u1ED9c t\u1EA5n c\xF4ng man r\u1EE3 c\u1EE7a
      L\u0169 K\u1EC1n K\u1EC1n \u0111\xE3 bi\u1EBFn nhi\u1EC7m v\u1EE5 th\xE0nh
      m\u1ED9t cu\u1ED9c truy \u0111u\u1ED5i sinh t\u1EED.  Gi\u1EDD \u0111\xE2y,
      b\u1EA1n ph\u1EA3i chi\u1EBFn \u0111\u1EA5u \u0111\u1EC3 thu h\u1ED3i l\u1EA1i
      c\u1ED5 v\u1EADt, tr\u1EEBng ph\u1EA1t nh\u1EEFng k\u1EBB \u0111\xE3 g\xE2y
      ra s\u1EF1 h\u1ED7n lo\u1EA1n v\xE0 ng\u0103n ch\u1EB7n c\xE1c phe ph\xE1i
      c\u01A1 h\u1ED9i kh\xE1c. H\xE3y mang L\xF5i Genesis tr\u1EDF v\u1EC1, Ch\u1EC9
      huy. H\xE3y ch\u1EE9ng minh r\u1EB1ng tr\u1EADt t\u1EF1 l\xE0 b\u1EE9c t\u01B0\u1EDDng
      duy nh\u1EA5t c\xF3 th\u1EC3 ng\u0103n ch\u1EB7n s\u1EF1 \u0111i\xEAn r\u1ED3
      \u0111ang nu\u1ED1t ch\u1EEDng thi\xEAn h\xE0."
    spiteskill1: {fileID: 604434037131846086, guid: ce3581f0ba226bf45a8eee32d486b60a, type: 3}
    spiteskill2: {fileID: 4656352391686552702, guid: 30384794c1f8a8c43bf1c572c8589438, type: 3}
    NameSkill1: "Ph\xE1o Ion"
    NameSkill2: " K\xEAu G\u1ECDi Si\xEAu H\u1EA1m \u0110\u1ED9i Ti\xEAn Phong"
    DescriptionSkill1: "B\u1EAFn m\u1ED9t lu\u1ED3ng \u0111\u1EA1n ion,G\xE2y s\xE1t
      th\u01B0\u01A1ng l\u1EDBn v\xE0 \u0111\xE1nh b\u1EA1i m\u1ECDi th\u1EE9 n\xF3
      \u0111i qua"
    DescriptionSkill2: "M\u1EDF c\u1ED5ng kh\xF4ng gian tri\u1EC7u h\u1ED3i si\xEAu
      chi\u1EBFn h\u1EA1m \u0111\u1ED3ng minh t\u1EF1 \u0111\u1ED9ng chi\u1EBFn \u0111\u1EA5u
      y\u1EC3m tr\u1EE3."
    damecoban: 10
    maucoban: 120
    damenangcap: 0
    maunangcap: 0
    coinnangcapmau: 0
    coinnangcapdame: 0
